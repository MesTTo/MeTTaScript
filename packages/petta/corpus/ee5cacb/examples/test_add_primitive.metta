!(add-atom &space "Hello")
!(add-atom &space 42)
!(add-atom &space (A B))

!(test (collapse (match &space $x $x)) ("Hello" 42 (A B)))

; Primitive storage must not overlap expression rows.
!(add-atom &space (#primitive 42))
!(test (collapse (match &space (#primitive $x) $x)) (42))
!(test (collapse (match &space ($r $x) ($r $x))) ((A B) (#primitive 42)))
!(test (collapse (match &space (, 42 (A $x)) $x)) (B))
!(test (collapse (match &space (, $x) $x)) ("Hello" 42 (A B) (#primitive 42)))
!(remove-atom &space 42)
!(test (collapse (match &space 42 found)) ())
!(test (collapse (match &space (#primitive $x) $x)) (42))
!(remove-atom &space (#primitive 42))
!(remove-atom &space "Hello")
!(test (collapse (get-atoms &space)) ((A B)))

; The empty expression, symbols, and booleans round-trip too.
!(add-atom &other ())
!(add-atom &other symbol)
!(add-atom &other True)
!(test (collapse (get-atoms &other)) (() symbol True))
!(test (collapse (match &other () found)) (found))
!(test (collapse (match &other symbol found)) (found))
!(test (collapse (match &other True found)) (found))
!(remove-atom &other ())
!(remove-atom &other symbol)
!(remove-atom &other True)
!(test (collapse (get-atoms &other)) ())

; Primitive mutations and matches require a concrete space name, like expression rows.
!(test (let (Error instantiation_error $c) (catch (add-atom $space 42)) raised) raised)
!(test (collapse (match &left 42 found)) ())
!(test (collapse (match &right 42 found)) ())
!(test (let (Error $e $c) (catch (add-atom 7 42)) raised) raised)
!(add-atom &left 7)
!(add-atom &right 7)
!(test (let (Error instantiation_error $c) (catch (remove-atom $space 7)) raised) raised)
!(test (let (Error $e $c) (catch (remove-atom "bad" 7)) raised) raised)
!(test (let (Error instantiation_error $c) (catch (match $space 7 found)) raised) raised)
!(test (let (Error instantiation_error $c) (catch (match $space (, 7) found)) raised) raised)
!(test (collapse (match &left 7 found)) (found))
!(test (collapse (match &right 7 found)) (found))
