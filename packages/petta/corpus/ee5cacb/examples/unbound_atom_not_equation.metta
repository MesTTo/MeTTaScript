; A definition must have an atom as its function name, just as when loading it.
(= (f) 1)
(= (g) 2)
!(test (let (Error instantiation_error $c) (catch (remove-atom &self $x)) raised) raised)
!(test (let (Error instantiation_error $c) (catch (remove-atom &self (= $h $b))) raised) raised)
!(test (f) 1)
!(test (g) 2)
!(test (collapse (match &self (= (f) $body) $body)) (1))
!(test (collapse (match &self (= (g) $body) $body)) (2))
!(test (let (Error instantiation_error $c) (catch (add-atom &unbound $y)) raised) raised)
!(test (add-atom &other (= $h 1)) True)
!(test (collapse (match &other (= $h 1) $h)) ($unbound))
!(test (add-atom &literal (= (42) 3)) True)
!(test (add-atom &literal (= ("f") 4)) True)
!(test (collapse (match &literal (= (42) $x) $x)) (3))
!(test (collapse (match &literal (= ("f") $x) $x)) (4))
!(test (remove-atom &literal (= (42) 3)) True)
!(test (collapse (match &literal (= (42) $x) $x)) ())
!(test (f) 1)

; A statically proven typed-space update must not invent an equation for an unbound row.
(: &open-rows (SpaceOf Expression))
(: put-open (-> Expression Bool))
(= (put-open $row) (add-atom &open-rows $row))
!(test (let (Error instantiation_error $c) (catch (put-open $row)) raised) raised)
!(test (collapse (get-atoms &open-rows)) ())
